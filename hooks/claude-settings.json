{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/ia5k-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/ia5k-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/ia5k-p1-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__tokensave__.*|mcp__code-review-graph__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/ia5k-p1-marca.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/ia5k-registrar-edicao.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/verificar-ferramentas.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/apes-ia5k/scripts/ia5k-stop-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
